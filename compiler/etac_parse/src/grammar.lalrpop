use etac_source::{Span, Symbol};
use etac_errors::{etac_error, Diag};
use etac_lexer::Token;
use etac_ast::ast::*;

use crate::{ParseState, lvalue_to_expr};
use crate::alloc;

grammar<'dcx, 'src>(state: &mut ParseState<'dcx, 'src>);

// ---- macros ----

CommaPlus<T>: Vec<T> = {
    <e:T>				=> vec![e],
    <mut v:CommaPlus<T>> "," <e:T>	=> { v.push(e); v },
}

Comma<T>: Vec<T> = {
    <v:CommaPlus<T>>	=> v,
                        => vec![],
}

CommaTrailing<T>: Vec<T> = {
    <v:CommaTrailingNonEmpty<T>>    => v,
				    => vec![],
}

CommaTrailingNonEmpty<T>: Vec<T> = {
    <v:CommaPlus<T>> ","? => v,
}

// ---- Token bindings ----
extern {
    type Location = u32;
    type Error = Diag<'dcx>;

    enum Token {
        "use"     => Token::KeywordUse,
        "length"  => Token::KeywordLength,
        "while"   => Token::KeywordWhile,
        "if"      => Token::KeywordIf,
        "else"    => Token::KeywordElse,
        "return"  => Token::KeywordReturn,
        "int"     => Token::KeywordInt,
        "bool"    => Token::KeywordBool,

        ";"       => Token::SemiColon,
        "_"       => Token::Discard,
        ":"       => Token::OfType,
        "="       => Token::Assign,
        ","       => Token::Comma,

        "("       => Token::LParen,
        ")"       => Token::RParen,
        "["       => Token::LBracket,
        "]"       => Token::RBracket,
        "{"       => Token::BlockOpen,
        "}"       => Token::BlockClose,

        "*"       => Token::OperatorMul,
        "*>>"     => Token::OperatorHighMul,
        "/"       => Token::OperatorDiv,
        "%"       => Token::OperatorMod,
        "!"       => Token::OperatorNot,
        "-"       => Token::Minus,
        "+"       => Token::OperatorAdd,
        "=="      => Token::RelOpEq,
        "!="      => Token::RelOpNeq,
        ">"       => Token::RelOpGr,
        ">="      => Token::RelOpGe,
        "<"       => Token::RelOpLt,
        "<="      => Token::RelOpLe,
        "&"       => Token::Land,
        "|"       => Token::Lor,

        "boollit" => Token::BoolLiteral(<bool>),
        "charlit" => Token::CharLiteral(<u32>),
        "strlit"  => Token::StrLiteral(<String>),
        "ident"   => Token::Identifier(<Symbol>),
        "intlit"  => Token::Integer(<i64>),
    }
}

// -- error handeling --

Error: Span = {
    <l:@L> <e:!> <r:@R> => { 
	state.lalrpop_errs.push(e);
	l..r.into()
    }
}

// Top level

pub Program: Program = {
    <l:@L> <uses:Use*> <definitions:DefinitionKind+> <r:@R> => Program { span: l..r.into(), uses, definitions },

    <uses:Use*> <r:@R> =>? Err(
	etac_error! {
	    state.diagc, r..r, "Program must contain at least one definition";
	    primary: "expected definition"
	}.into()
    ),
    <uses:Use*> <definitions:DefinitionKind+> <l:@L> <u:Use> <r:@R> <mul:Use*> =>? Err(
	etac_error! {
	    state.diagc, l..r, "Use statements must go above all defintions";
	    primary: "Use not allowed here";
	    note: "Try moving this use to the top of the file";
	}.into()
    ),
    
}

pub Interface: Interface = {
    <l:@L> <items:InterfaceItemKind+> <r:@R> => Interface { span: l..r.into(), items },
    <r:@R> =>? Err(
	etac_error! {
	    state.diagc, r..r, "Interface must contain at least one method declaration";
	    primary: "expected declaration"
	}.into()
    ),
}

Use: Use = {
    <l:@L> "use" <interface:Ident> ";"? <r:@R> => Use { span: l..r.into(), interface },
}

DefinitionKind: DefinitionKind = {
    Method    	=> DefinitionKind::Method(<>),
    GlobDecl 	=> DefinitionKind::GlobDecl(<>),
    Error	=> DefinitionKind::Error(<>)
}

InterfaceItemKind: InterfaceItemKind = {
    MethodDecl	=> InterfaceItemKind::MethodDecl(<>),
    Error 	=> InterfaceItemKind::Error(<>),
}

MethodDecl: MethodDecl = {
    <l:@L> 
	<id:Ident> "(" <params:Comma<Decl>> ")" 
	<ret:(":" <CommaPlus<TypeKind>>)?> 
    <r:@R> =>
        MethodDecl { span: l..r.into(), id, params, ret: ret.unwrap_or_default() },
}

Method: Method = {
    <l:@L> <decl:MethodDecl> <body:MethodBodyKind> <r:@R> => Method { span: l..r.into(), decl, body },
}

MethodBodyKind: MethodBodyKind = {
    Block => MethodBodyKind::Block(<>),
    Error => MethodBodyKind::Error(<>),
}

GlobDecl: GlobDecl = {
    <l:@L> <id:Ident> ":" <typ:GlobDeclTypeKind> <val:("=" <LitKind>)?> ";"? <r:@R> =>
	GlobDecl { span: l..r.into(), id, typ, val },
}

// -- statements -- 

StmtKind: StmtKind = {
    Stmt_Open,
    Stmt_Closed,
    <l:@L> <e:!> <r:@R> => { state.lalrpop_errs.push(e); StmtKind::Error(l..r.into()) }
}

IfStmt: IfStmt = {
    IfStmt_Open,
    IfStmt_Closed,
}

WhileStmt: WhileStmt = {
    WhileStmt_Open,
    WhileStmt_Closed,
}

ReturnStmt: ReturnStmt = {
    <l:@L> "return" <values:Comma<ExprKind>> ";"? <r:@R> => ReturnStmt { span: l..r.into(), values },
}


Block: Block = {
    <l:@L> "{" <mut stmts:(<StmtKind> ";"?)*> <ret:ReturnStmt?> "}" <r:@R> => {
	if let Some(ret) = ret { stmts.push(StmtKind::Return(ret)); }
	Block { span: l..r.into(), stmts }
    },
}

AssignStmt: AssignStmt = {
    <l:@L> <targets:TargetKind> "=" <values:CommaPlus<ExprKind>> <r:@R> => AssignStmt { span: l..r.into(), targets, values },
}

Decl: Decl = {
    <l:@L> <id:Ident> ":" <typ:TypeKind> <r:@R> => Decl { span: l..r.into(), id, typ },
}

// -- disambiguate assignment vs decl since we can't lookahead we need to keep possibilities as state -- 

Assign_Or_Decl: StmtKind = {
    <l:@L> <decls:DeclTargets> <r:@R> 						=> StmtKind::Decls(MultiDeclStmt { span: l..r.into(), decls }),
    <l:@L> <targets:DeclTargets> "=" <values:CommaPlus<ExprKind>> <r:@R> 	=> StmtKind::Assign(AssignStmt { span: l..r.into(), targets: targets.into_iter().map(TargetKind::Decl).collect(), values }),
    <l:@L> <targets:NonDeclTargets> "=" <values:CommaPlus<ExprKind>> <r:@R> 	=> StmtKind::Assign(AssignStmt { span: l..r.into(), targets, values }),
}

// pure decl target also valid as multi-decl
DeclTargets: Vec<Decl> = {
    Decl => vec![<>],
    <mut p:DeclTargets> "," <n:Decl> => { p.push(n); p }
}

// contains >0 non-decl target (not valid multi-decl)
NonDeclTargets: Vec<TargetKind> = {
    NonDeclTarget 				=> vec![<>],
    <p:DeclTargets> "," <n:NonDeclTarget> 	=> p.into_iter().map(TargetKind::Decl).chain(std::iter::once(n)).collect(),
    <mut p:NonDeclTargets> "," <n:NonDeclTarget>=> { p.push(n); p },
    <mut p:NonDeclTargets> "," <n:Decl> 	=> { p.push(TargetKind::Decl(n)); p }
}

NonDeclTarget: TargetKind = {
    LValueKind 	 	=> TargetKind::LValue(<>),
    Discard		=> TargetKind::Discard(<>),
}

// -- elses can be matched -- 

Stmt_Open: StmtKind = {
    IfStmt_Open 	=> StmtKind::If(<>),
    WhileStmt_Open 	=> StmtKind::While(<>),
}

IfStmt_Open: IfStmt = {
    <l:@L> "if" <cond:ExprKind> <t:StmtKind> <r:@R> 			=> 
	IfStmt { span: l..r.into(), cond, then_branch: Box::new(t), else_branch: None },
    <l:@L> "if" <cond:ExprKind> <t:Stmt_Closed> "else" <e:Stmt_Open> <r:@R> 	=> 
	IfStmt { span: l..r.into(), cond, then_branch: Box::new(t), else_branch: Some(Box::new(e)) },
}

WhileStmt_Open: WhileStmt = {
    <l:@L> "while" <cond:ExprKind> <body:Stmt_Open> <r:@R> => WhileStmt { span: l..r.into(), cond, body: Box::new(body) },
}

// -- nothing for else to match -- 

Stmt_Closed: StmtKind = {
    Assign_Or_Decl,
    IfStmt_Closed			=> StmtKind::If(<>),
    WhileStmt_Closed			=> StmtKind::While(<>),
    Block     				=> StmtKind::Block(<>),
    ProcCall   				=> StmtKind::Call(<>),
}

IfStmt_Closed: IfStmt = {
    <l:@L> "if" <cond:ExprKind> <t:Stmt_Closed> "else" <e:Stmt_Closed> <r:@R> => 
	IfStmt { span: l..r.into(), cond, then_branch: Box::new(t), else_branch: Some(Box::new(e)) },
}

WhileStmt_Closed: WhileStmt = {
    <l:@L> "while" <cond:ExprKind> <body:Stmt_Closed> <r:@R> => 
	WhileStmt { span: l..r.into(), cond, body: Box::new(body) },
}


// -- types --

TypeKind: TypeKind = {
    TypeSized,
    TypeUnsized,
    <l:@L> <e:!> <r:@R> => { state.lalrpop_errs.push(e); TypeKind::Error(l..r.into()) }
}

GlobDeclTypeKind: TypeKind = {
    TypeUnsized,
    <l:@L> <_t:TypeSized> <r:@R> =>? Err(etac_error! {
	state.diagc, l..r.into(), "global arrays can't be initialized at the point of declaration";
	primary: "initialization happens here"
    }.into()),
}

TypeUnsized: TypeKind = {
    <base:TypeUnsized> <l:@L> <udim:UnsizedDim> <r:@R> => 
	TypeKind::Array(ArrType { span: l..r.into(), of: Box::new(base), size: None }),
    <base:TypeSized> <l:@L> <udim:UnsizedDim> <r:@R> =>
	TypeKind::Array(ArrType { span: l..r.into(), of: Box::new(base), size: None }),
}

TypeSized: TypeKind = {
    <l:@L> "int" <r:@R> 				=> TypeKind::Int(l..r.into()),
    <l:@L> "bool" <r:@R> 				=> TypeKind::Bool(l..r.into()),
    <base:TypeSized> <l:@L> <size:SizedDim> <r:@R> 	=> TypeKind::Array(ArrType { span: l..r.into(), of: Box::new(base), size })
}

SizedDim: Option<ExprKind> = {
   "[" ExprKind "]" => Some(<>)
}

UnsizedDim: Option<ExprKind> = {
    "[" "]" => None
}

// -- targets & lvalues --

TargetKind: TargetKind = {
    LValueKind 	=> TargetKind::LValue(<>),
    Decl 	=> TargetKind::Decl(<>),
    Discard	=> TargetKind::Discard(<>),
}

Discard: Span = {
    <l:@L> "_" <r:@R> => l..r.into()
}

LValueKind: LValueKind = {
    Ident 			=> LValueKind::Id(<>),
    ProcCall 			=> LValueKind::ProcCall(<>),
    ExprIndex<LValueExprs> 	=> LValueKind::Index(<>),
}

LValueExprs: ExprKind = {
    Ident 			=> ExprKind::Id(<>),
    ProcCall 			=> ExprKind::Call(<>),
    ExprIndex<LValueExprs> 	=> ExprKind::Index(<>),
}

// ---- expressions ----

Ident: Ident = {
    <l:@L> <sym:"ident"> <r:@R> => Ident { span: l..r.into(), sym },
}

ProcCall: ProcCall = {
    <l:@L> <id:Ident> "(" <args:Comma<ExprKind>> ")" <r:@R> => ProcCall { span: l..r.into(), id, args },
}

LengthCall: LengthCall = {
    <l:@L> "length" "(" <array:ExprKind> ")" <r:@R> => LengthCall { span: l..r.into(), param: Box::new(array) },
}

LitKind: LitKind = {
    IntLit,
    BoolLit,
    CharLit,
    ArrayLitKind => LitKind::Array(<>)
}

IntLit:  LitKind = { <l:@L> <value:"intlit">  <r:@R> => LitKind::Int  { span: l..r.into(), value } }
BoolLit: LitKind = { <l:@L> <value:"boollit"> <r:@R> => LitKind::Bool { span: l..r.into(), value } }
CharLit: LitKind = { <l:@L> <value:"charlit"> <r:@R> => LitKind::Char { span: l..r.into(), value } }

ArrayLitKind: ArrayLitKind = {
    StringLit => ArrayLitKind::String(<>),
    ArrayLit => ArrayLitKind::Array(<>),
}
StringLit: StringLit = { 
    <l:@L> <s:"strlit"> <r:@R> => StringLit { span: l..r.into(), value: s.chars().collect() },
}
ArrayLit: ArrayLit = { 
    <l:@L> "[" <elems:CommaTrailing<ExprKind>> "]" <r:@R> => ArrayLit { span: l..r.into(), value: elems },
}

ExprIndex<ExprKindSubset>: ExprIndex = {
    <l:@L> <a:ExprKindSubset> "[" <i:ExprKind> "]" <r:@R> => ExprIndex { span: l..r.into(), array: Box::new(a), index: Box::new(i) },
}

PrimaryExprs: ExprKind = {
    LitKind    => ExprKind::Lit(<>),
    Ident      => ExprKind::Id(<>),
    ProcCall   => ExprKind::Call(<>),
    LengthCall => ExprKind::Length(<>),
    "("ExprKind")",
    ExprIndex<PrimaryExprs> => ExprKind::Index(<>),
    Error      => ExprKind::Error(<>),
};

ExprKind: ExprKind = {
    #[precedence(level="0")]
    PrimaryExprs,

    #[precedence(level="1")] #[assoc(side="right")]
    <l:@L> 
	<op:UOp<PL1>> 
	<operand:ExprKind> 
    <r:@R> => UnaryExpr { span: l..r.into(), op, operand: Box::new(operand) },

    #[precedence(level="2")] #[assoc(side="left")]
    <l:@L> 
	<lhs:ExprKind> 
	<op:BinOp<PL2>> 
	<rhs:ExprKind> 
    <r:@R> => BinaryExpr { span: l..r.into(), op, lhs: Box::new(lhs), rhs: Box::new(rhs) },

    #[precedence(level="3")] #[assoc(side="left")]
    <l:@L> 
	<lhs:ExprKind> 
	<op:BinOp<PL3>> 
	<rhs:ExprKind> 
    <r:@R> => BinaryExpr { span: l..r.into(), op, lhs: Box::new(lhs), rhs: Box::new(rhs) },

    #[precedence(level="4")] #[assoc(side="left")]
    <l:@L> 
	<lhs:ExprKind> 
	<op:BinOp<PL4>> 
	<rhs:ExprKind> 
    <r:@R> => BinaryExpr { span: l..r.into(), op, lhs: Box::new(lhs), rhs: Box::new(rhs) },

    #[precedence(level="5")] #[assoc(side="left")]
    <l:@L> 
	<lhs:ExprKind> 
	<op:BinOp<PL5>> 
	<rhs:ExprKind> 
    <r:@R> => BinaryExpr { span: l..r.into(), op, lhs: Box::new(lhs), rhs: Box::new(rhs) },

    #[precedence(level="6")] #[assoc(side="left")]
    <l:@L> 
	<lhs:ExprKind> 
	<op:BinOp<PL6>> 
	<rhs:ExprKind> 
    <r:@R> => BinaryExpr { span: l..r.into(), op, lhs: Box::new(lhs), rhs: Box::new(rhs) },

    #[precedence(level="7")] #[assoc(side="left")]
    <l:@L> 
	<lhs:ExprKind> 
	<op:BinOp<PL7>> 
	<rhs:ExprKind> 
    <r:@R> => BinaryExpr { span: l..r.into(), op, lhs: Box::new(lhs), rhs: Box::new(rhs) },
};

// -- operator helper macros --

#[inline]
BinOp<BinOpKind>: BinOp = {
    <l:@L> <kind:BinOpKind> <r:@R> => BinOp { span: l..r.into(), kind }
}

#[inline]
UOp<UOpKind>: UOp = {
    <l:@L> <kind:UOpKind> <r:@R> => UOp { span: l..r.into(), kind }
}

// -- operator bindings --

PL1: UOpKind = {
    "-" 	=> UOpKind::Neg,
    "!" 	=> UOpKind::Not,
}
PL2: BinOpKind = {
    "*" 	=> BinOpKind::Mul,
    "*>>" 	=> BinOpKind::HighMul,
    "/" 	=> BinOpKind::Div,
    "%" 	=> BinOpKind::Mod,
}
PL3: BinOpKind = {
    "+" 	=> BinOpKind::Plus,
    "-" 	=> BinOpKind::Minus,
}
PL4: BinOpKind = {
    "<" 	=> BinOpKind::Lt,
    "<=" 	=> BinOpKind::Le,
    ">" 	=> BinOpKind::Gt,
    ">=" 	=> BinOpKind::Ge,
}
PL5: BinOpKind = {
    "==" 	=> BinOpKind::Eq,
    "!=" 	=> BinOpKind::Neq,
}
PL6: BinOpKind = {
    "&" 	=> BinOpKind::LAnd,
}
PL7: BinOpKind = {
    "|" 	=> BinOpKind::LOr,
}
