use etac_source::Span;
use etac_intern::Symbol;
use etac_errors::{etac_error, dcx::Diag};
use etac_lexer::token::RawToken;
use etac_ast::ast::*;

use crate::state::ParseState;

grammar<'dcx>(state: &mut ParseState<'dcx>);

// ---- macros ----

CommaPlus<T>: Vec<T> = {
    <e:T>				=> vec![e],
    <mut v:CommaPlus<T>> "," <e:T>	=> { v.push(e); v },
}

Comma<T>: Vec<T> = {
    <v:CommaPlus<T>>	=> v,
                        => vec![],
}

CommaTrailing<T>: Vec<T> = {
    <v:CommaTrailingNonEmpty<T>>    => v,
				    => vec![],
}

CommaTrailingNonEmpty<T>: Vec<T> = {
    <v:CommaPlus<T>> ","? => v,
}

// ---- Token bindings ----
extern {
    type Location = u32;
    type Error = Diag<'dcx>;

    enum RawToken {
        "use"     => RawToken::KeywordUse,
        "length"  => RawToken::KeywordLength,
        "while"   => RawToken::KeywordWhile,
        "if"      => RawToken::KeywordIf,
        "else"    => RawToken::KeywordElse,
        "return"  => RawToken::KeywordReturn,
        "int"     => RawToken::KeywordInt,
        "bool"    => RawToken::KeywordBool,

        ";"       => RawToken::SemiColon,
        "_"       => RawToken::Discard,
        ":"       => RawToken::OfType,
        "="       => RawToken::Assign,
        ","       => RawToken::Comma,

        "("       => RawToken::LParen,
        ")"       => RawToken::RParen,
        "["       => RawToken::LBracket,
        "]"       => RawToken::RBracket,
        "{"       => RawToken::BlockOpen,
        "}"       => RawToken::BlockClose,

        "*"       => RawToken::OperatorMul,
        "*>>"     => RawToken::OperatorHighMul,
        "/"       => RawToken::OperatorDiv,
        "%"       => RawToken::OperatorMod,
        "!"       => RawToken::OperatorNot,
        "-"       => RawToken::Minus,
        "+"       => RawToken::OperatorAdd,
        "=="      => RawToken::RelOpEq,
        "!="      => RawToken::RelOpNeq,
        ">"       => RawToken::RelOpGr,
        ">="      => RawToken::RelOpGe,
        "<"       => RawToken::RelOpLt,
        "<="      => RawToken::RelOpLe,
        "&"       => RawToken::Land,
        "|"       => RawToken::Lor,

        "bool literal" => RawToken::BoolLiteral(<bool>),
        "char literal" => RawToken::CharLiteral(<char>),
        "string literal"  => RawToken::StrLiteral(<Symbol>),
        "identifier"   => RawToken::Identifier(<Symbol>),
        "int literal"  => RawToken::Integer(<u64>),
    }
}

// -- error handeling --

Error: Span = {
    <l:@L> <e:!> <r:@R> => { 
	state.lalrpop_errs.push(e);
	(l..r).into()
    }
}

// Top level

pub Program: Program = {
    <l:@L> <uses:Use*> <definitions:DefinitionKind+> <r:@R> => Program { span: (l..r).into(), uses, definitions },

    <uses:Use*> <r:@R> =>? Err(
	etac_error! {
	    state.dcx, r..r, "Program must contain at least one definition";
	    primary: "expected definition"
	}.into()
    ),
    <uses:Use*> <definitions:DefinitionKind+> <l:@L> <u:Use> <r:@R> <mul:Use*> =>? Err(
	etac_error! {
	    state.dcx, l..r, "Use statements must go above all definitions";
	    primary: "Use not allowed here";
	    note: "Try moving this use to the top of the file";
	}.into()
    ),
    
}

pub Interface: Interface = {
    <l:@L> <items:InterfaceItemKind+> <r:@R> => Interface { span: (l..r).into(), items },
    <r:@R> =>? Err(
	etac_error! {
	    state.dcx, r..r, "Interface must contain at least one method declaration";
	    primary: "expected declaration"
	}.into()
    ),
}

Use: Use = {
    <l:@L> "use" <interface:Ident> ";"? <r:@R> => Use { span: (l..r).into(), interface },
}

DefinitionKind: DefinitionKind = {
    Method    	=> DefinitionKind::Method(<>),
    GlobDecl 	=> DefinitionKind::GlobDecl(<>),
    Error	=> DefinitionKind::Error(Error(<>))
}

InterfaceItemKind: InterfaceItemKind = {
    MethodDecl	=> InterfaceItemKind::MethodDecl(<>),
    Error 	=> InterfaceItemKind::Error(Error(<>)),
}

MethodDecl: MethodDecl = {
    <l:@L> 
	<id:Ident> "(" <params:Comma<Decl>> ")" 
	<ret:(":" <CommaPlus<TypeKind>>)?> 
    <r:@R> =>
        MethodDecl { span: (l..r).into(), id, params, ret_types: ret.unwrap_or_default() },
}

Method: Method = {
    <l:@L> <decl:MethodDecl> <body:MethodBodyKind> <r:@R> => Method { span: (l..r).into(), decl, body },
}

MethodBodyKind: MethodBodyKind = {
    Block => MethodBodyKind::Block(<>),
    Error => MethodBodyKind::Error(Error(<>)),
}

GlobDecl: GlobDecl = {
    <l:@L> <id:Ident> ":" <typ:TypeKind> <init_l:@L> <val:("=" <GlobDeclValue>)?> <init_r:@R> ";"? <r:@R> =>?
	match typ {
	    TypeKind::Array(_) if val.is_some() => Err(etac_error! { state.dcx, 
		    init_l..init_r, "global arrays can't be initialized at the point of declaration";
		    primary: "initialization happens here"
		}.into()),
	    ref allowed => Ok(GlobDecl { span: (l..r).into(), id, typ, val }),
	},
}

// -- statements -- 

StmtKind: StmtKind = {
    Stmt_Open,
    Stmt_Closed,
    <l:@L> <e:!> <r:@R> => { state.lalrpop_errs.push(e); StmtKind::Error(Error((l..r).into())) }
}

IfStmt: IfStmt = {
    IfStmt_Open,
    IfStmt_Closed,
}

WhileStmt: WhileStmt = {
    WhileStmt_Open,
    WhileStmt_Closed,
}

ReturnStmt: ReturnStmt = {
    <l:@L> "return" <values:Comma<ExprKind>> ";"? <r:@R> => ReturnStmt { span: (l..r).into(), values },
}


Block: Block = {
    <l:@L> "{" <mut stmts:(<StmtKind> ";"?)*> <ret:ReturnStmt?> "}" <r:@R> => {
	if let Some(ret) = ret { stmts.push(StmtKind::Return(ret)); }
	Block { span: (l..r).into(), stmts }
    },
}

Decl: Decl = {
    <l:@L> <id:Ident> ":" <typ:TypeKind> <r:@R> => Decl { span: (l..r).into(), id, typ },
}

// -- disambiguate assignment vs decl since we can't lookahead we need to keep possibilities as state -- 

Assign_Or_Decl: StmtKind = {
    <l:@L> <decls:DeclTargets> <r:@R> 						=> StmtKind::Decls(MultiDeclStmt { span: (l..r).into(), decls }),
    <l:@L> <targets:DeclTargets> "=" <values:CommaPlus<ExprKind>> <r:@R> 	=> StmtKind::Assign(AssignStmt { span: (l..r).into(), targets: targets.into_iter().map(TargetKind::Decl).collect(), values }),
    <l:@L> <targets:NonDeclTargets> "=" <values:CommaPlus<ExprKind>> <r:@R> 	=> StmtKind::Assign(AssignStmt { span: (l..r).into(), targets, values }),
}

// pure decl target also valid as multi-decl
DeclTargets: Vec<Decl> = {
    Decl => vec![<>],
    <mut p:DeclTargets> "," <n:Decl> => { p.push(n); p }
}

// contains >0 non-decl target (not valid multi-decl)
NonDeclTargets: Vec<TargetKind> = {
    NonDeclTarget 				=> vec![<>],
    <p:DeclTargets> "," <n:NonDeclTarget> 	=> p.into_iter().map(TargetKind::Decl).chain(std::iter::once(n)).collect(),
    <mut p:NonDeclTargets> "," <n:NonDeclTarget>=> { p.push(n); p },
    <mut p:NonDeclTargets> "," <n:Decl> 	=> { p.push(TargetKind::Decl(n)); p }
}

NonDeclTarget: TargetKind = {
    LValueKind 	 	=> TargetKind::LValue(<>),
    Discard		=> TargetKind::Discard(<>),
}

// -- elses can be matched -- 

Stmt_Open: StmtKind = {
    IfStmt_Open 	=> StmtKind::If(<>),
    WhileStmt_Open 	=> StmtKind::While(<>),
}

IfStmt_Open: IfStmt = {
    <l:@L> "if" <cond:ExprKind> <t:StmtKind> <r:@R> 			=> 
	IfStmt { span: (l..r).into(), cond: Box::new(cond), then_branch: Box::new(t), else_branch: None },
    <l:@L> "if" <cond:ExprKind> <t:Stmt_Closed> "else" <e:Stmt_Open> <r:@R> 	=> 
	IfStmt { span: (l..r).into(), cond: Box::new(cond), then_branch: Box::new(t), else_branch: Some(Box::new(e)) },
}

WhileStmt_Open: WhileStmt = {
    <l:@L> "while" <cond:ExprKind> <body:Stmt_Open> <r:@R> => WhileStmt { span: (l..r).into(), cond: Box::new(cond), body: Box::new(body) },
}

// -- nothing for else to match -- 

Stmt_Closed: StmtKind = {
    Assign_Or_Decl,
    IfStmt_Closed			=> StmtKind::If(<>),
    WhileStmt_Closed			=> StmtKind::While(<>),
    Block     				=> StmtKind::Block(<>),
    ProcCall   				=> StmtKind::Call(<>),
}

IfStmt_Closed: IfStmt = {
    <l:@L> "if" <cond:ExprKind> <t:Stmt_Closed> "else" <e:Stmt_Closed> <r:@R> => 
	IfStmt { span: (l..r).into(), cond: Box::new(cond), then_branch: Box::new(t), else_branch: Some(Box::new(e)) },
}

WhileStmt_Closed: WhileStmt = {
    <l:@L> "while" <cond:ExprKind> <body:Stmt_Closed> <r:@R> => 
	WhileStmt { span: (l..r).into(), cond: Box::new(cond), body: Box::new(body) },
}


// -- types --

TypeKind: TypeKind = {
    TypeSized,
    TypeUnsized,
    <l:@L> <e:!> <r:@R> => { state.lalrpop_errs.push(e); TypeKind::Error(Error((l..r).into())) }
}

GlobDeclTypeKind_Sized: TypeKind = {
    TypeUnsized,

}


TypeUnsized: TypeKind = {
    <base:TypeUnsized> <l:@L> <udim:UnsizedDim> <r:@R> => 
	TypeKind::Array(ArrType { span: (l..r).into(), of: Box::new(base), size: None }),
    <base:TypeSized> <l:@L> <udim:UnsizedDim> <r:@R> =>
	TypeKind::Array(ArrType { span: (l..r).into(), of: Box::new(base), size: None }),
}

TypeSized: TypeKind = {
    <l:@L> "int" <r:@R> 				=> TypeKind::Int((l..r).into()),
    <l:@L> "bool" <r:@R> 				=> TypeKind::Bool((l..r).into()),
    <base:TypeSized> <l:@L> <size:SizedDim> <r:@R> 	=> TypeKind::Array(ArrType { span: (l..r).into(), of: Box::new(base), size })
}

SizedDim: Option<Box<ExprKind>> = {
   "[" <e:ExprKind> "]" => Some(Box::new(e))
}

UnsizedDim: Option<Box<ExprKind>> = {
    "[" "]" => None
}

// -- targets & lvalues --

TargetKind: TargetKind = {
    LValueKind 	=> TargetKind::LValue(<>),
    Decl 	=> TargetKind::Decl(<>),
    Discard	=> TargetKind::Discard(<>),
}

Discard: Span = {
    <l:@L> "_" <r:@R> => (l..r).into()
}

LValueKind: LValueKind = {
    Ident 			=> LValueKind::Id(<>),
    ProcCall 			=> LValueKind::ProcCall(<>),
    ExprIndex<LValueExprs> 	=> LValueKind::Index(<>),
}

LValueExprs: ExprKind = {
    Ident 			=> ExprKind::Id(<>),
    ProcCall 			=> ExprKind::Call(<>),
    ExprIndex<LValueExprs> 	=> ExprKind::Index(<>),
}

// ---- expressions ----

Ident: Ident = {
    <l:@L> <sym:"identifier"> <r:@R> => Ident { span: (l..r).into(), sym },
}

ProcCall: ProcCall = {
    <l:@L> <id:Ident> "(" <args:Comma<ExprKind>> ")" <r:@R> => ProcCall { span: (l..r).into(), id, args },
}

LengthCall: LengthCall = {
    <l:@L> "length" "(" <array:ExprKind> ")" <r:@R> => LengthCall { span: (l..r).into(), param: Box::new(array) },
}

GlobDeclValue: GlobDeclValue = {
    LitKind 						=> GlobDeclValue::Literal(<>),
    <l:@L> <op:UOp<UnaryMinus>> <value:IntLit> <r:@R> 	=> GlobDeclValue::Neg { span: (l..r).into(), value },
}

LitKind: LitKind = {
    IntLit  => LitKind::Int(<>),
    BoolLit => LitKind::Bool(<>),
    CharLit => LitKind::Char(<>),
    ArrayLitKind => LitKind::Array(<>)
}

BoolLit: BoolLit = { <l:@L> <value:"bool literal"> <r:@R> => BoolLit { span: (l..r).into(), value } }
CharLit: CharLit = { <l:@L> <value:"char literal"> <r:@R> => CharLit { span: (l..r).into(), value } }
IntLit:  IntLit  = { <l:@L> <value:"int literal">  <r:@R> => IntLit  { span: (l..r).into(), value } }

ArrayLitKind: ArrayLitKind = {
    StringLit => ArrayLitKind::String(<>),
    ArrayLit => ArrayLitKind::Array(<>),
}
StringLit: StringLit = { 
    <l:@L> <value:"string literal"> <r:@R> => StringLit { span: (l..r).into(), value },
}
ArrayLit: ArrayLit = { 
    <l:@L> "{" <elems:CommaTrailing<ExprKind>> "}" <r:@R> => ArrayLit { span: (l..r).into(), value: elems },
}

ExprIndex<ExprKindSubset>: ExprIndex = {
    <l:@L> <a:ExprKindSubset> "[" <i:ExprKind> "]" <r:@R> => ExprIndex { span: (l..r).into(), array: Box::new(a), index: Box::new(i) },
}

PrimaryExprs: ExprKind = {
    LitKind    => ExprKind::Lit(<>),
    Ident      => ExprKind::Id(<>),
    Error      => ExprKind::Error(Error(<>)),
    ProcCall   => ExprKind::Call(<>),
    LengthCall => ExprKind::Length(<>),
    "(" <e:ExprKind> ")" => e,
    ExprIndex<PrimaryExprs> => ExprKind::Index(<>),
}

ExprKind: ExprKind = {
    #[precedence(level="0")]
    PrimaryExprs,

    #[precedence(level="1")]
    <l:@L> 
	<op:UOp<PL1>>
	<operand:ExprKind> 
    <r:@R> => ExprKind::Unary(UnaryExpr { span: (l..r).into(), op, operand: Box::new(operand) }),

    #[precedence(level="2")] #[assoc(side="left")]
    <l:@L> 
	<lhs:ExprKind> 
	<op:BinOp<PL2>> 
	<rhs:ExprKind> 
    <r:@R> => ExprKind::Binary(BinaryExpr { span: (l..r).into(), op, lhs: Box::new(lhs), rhs: Box::new(rhs) }),

    #[precedence(level="3")] #[assoc(side="left")]
    <l:@L> 
	<lhs:ExprKind> 
	<op:BinOp<PL3>> 
	<rhs:ExprKind> 
    <r:@R> => ExprKind::Binary(BinaryExpr { span: (l..r).into(), op, lhs: Box::new(lhs), rhs: Box::new(rhs) }),

    #[precedence(level="4")] #[assoc(side="left")]
    <l:@L> 
	<lhs:ExprKind> 
	<op:BinOp<PL4>> 
	<rhs:ExprKind> 
    <r:@R> => ExprKind::Binary(BinaryExpr { span: (l..r).into(), op, lhs: Box::new(lhs), rhs: Box::new(rhs) }),

    #[precedence(level="5")] #[assoc(side="left")]
    <l:@L> 
	<lhs:ExprKind> 
	<op:BinOp<PL5>> 
	<rhs:ExprKind> 
    <r:@R> => ExprKind::Binary(BinaryExpr { span: (l..r).into(), op, lhs: Box::new(lhs), rhs: Box::new(rhs) }),

    #[precedence(level="6")] #[assoc(side="left")]
    <l:@L> 
	<lhs:ExprKind> 
	<op:BinOp<PL6>> 
	<rhs:ExprKind> 
    <r:@R> => ExprKind::Binary(BinaryExpr { span: (l..r).into(), op, lhs: Box::new(lhs), rhs: Box::new(rhs) }),

    #[precedence(level="7")] #[assoc(side="left")]
    <l:@L> 
	<lhs:ExprKind> 
	<op:BinOp<PL7>> 
	<rhs:ExprKind> 
    <r:@R> => ExprKind::Binary(BinaryExpr { span: (l..r).into(), op, lhs: Box::new(lhs), rhs: Box::new(rhs) }),
};

// -- operator helper macros --

#[inline]
BinOp<BinOpKind>: BinOp = {
    <l:@L> <kind:BinOpKind> <r:@R> => BinOp { span: (l..r).into(), kind }
}

#[inline]
UOp<UOpKind>: UOp = {
    <l:@L> <kind:UOpKind> <r:@R> => UOp { span: (l..r).into(), kind }
}

// -- operator bindings --
#[inline]
UnaryMinus: UOpKind = {
    "-" 	=> UOpKind::Neg,
}

#[inline]
PL1: UOpKind = {
    UnaryMinus,
    "!" 	=> UOpKind::Not,
}
#[inline]
PL2: BinOpKind = {
    "*" 	=> BinOpKind::Mul,
    "*>>" 	=> BinOpKind::HighMul,
    "/" 	=> BinOpKind::Div,
    "%" 	=> BinOpKind::Mod,
}
#[inline]
PL3: BinOpKind = {
    "+" 	=> BinOpKind::Add,
    "-" 	=> BinOpKind::Sub,
}
#[inline]
PL4: BinOpKind = {
    "<" 	=> BinOpKind::Lt,
    "<=" 	=> BinOpKind::Le,
    ">" 	=> BinOpKind::Gt,
    ">=" 	=> BinOpKind::Ge,
}
#[inline]
PL5: BinOpKind = {
    "==" 	=> BinOpKind::Eq,
    "!=" 	=> BinOpKind::Neq,
}
#[inline]
PL6: BinOpKind = {
    "&" 	=> BinOpKind::LAnd,
}
#[inline]
PL7: BinOpKind = {
    "|" 	=> BinOpKind::LOr,
}
